{
  "type": "module",
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "analytics:share-funnel": "wrangler d1 execute douban-book-plus-feedback --remote --file ./queries/share-funnel.sql",
    "analytics:store-stats:manual": "wrangler dev --test-scheduled --config ./workers/share-analytics/wrangler.manual.jsonc",
    "analytics:worker:build": "wrangler deploy --dry-run --config ./workers/share-analytics/wrangler.jsonc --outdir .wrangler/share-analytics-worker",
    "analytics:worker:deploy": "wrangler deploy --config ./workers/share-analytics/wrangler.jsonc",
    "check": "pnpm run typecheck && pnpm run test:functions && pnpm run docs:build && pnpm run functions:build && pnpm run analytics:worker:build",
    "db:migrate:local": "wrangler d1 migrations apply douban-book-plus-feedback --local",
    "db:migrate:remote": "wrangler d1 migrations apply douban-book-plus-feedback --remote",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "functions:build": "wrangler pages functions build --outdir .wrangler/functions-build",
    "survey:results": "wrangler d1 execute douban-book-plus-feedback --remote --command \"SELECT reason, COUNT(*) AS responses FROM uninstall_responses GROUP BY reason ORDER BY responses DESC\"",
    "test:functions": "node --test functions/lib/*.test.ts workers/share-analytics/*.test.ts",
    "typecheck": "vue-tsc --noEmit && tsc --project functions/tsconfig.json --noEmit && tsc --project workers/share-analytics/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "vue": "3.5.40",
    "vue-tsc": "3.3.10",
    "wrangler": "4.138.0"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.19",
      "postcss": "8.5.28",
      "vite": "6.4.3"
    }
  }
}
