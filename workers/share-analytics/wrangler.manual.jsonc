{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "douban-book-plus-share-analytics-manual",
  "main": "./index.ts",
  "compatibility_date": "2026-08-17",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "douban-book-plus-feedback",
      "database_id": "34d7c35a-442e-4356-a8d1-5d2147ab667d",
      "remote": true
    }
  ],
  "ratelimits": [
    {
      "name": "SHARE_ANALYTICS_GLOBAL_RATE_LIMITER",
      "namespace_id": "910211",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "SHARE_ANALYTICS_CLIENT_RATE_LIMITER",
      "namespace_id": "910212",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
